{
  "schema": "firedrill.local-descriptor.v1",
  "source_roots": [
    {"alias": "sal", "identity_sha256": "{{IDENTITY_SHA256}}"}
  ],
  "services": [
    {
      "alias": "agent",
      "root_alias": "sal",
      "role": "agent",
      "depends_on": [],
      "configuration": [
        {"name": "ANTHROPIC_API_KEY", "phase": "runtime", "secret": true, "required": true}
      ]
    }
  ],
  "entry_service": "agent",
  "driver": {
    "profile": "jsonl-process.v1",
    "adapter_sha256": "{{ADAPTER_SHA256}}",
    "authentication": "anonymous",
    "state_domains": ["proc"]
  },
  "state_domains": [
    {
      "alias": "proc",
      "service_alias": "agent",
      "kind": "process",
      "location": "local",
      "reset": "fresh-process",
      "concurrency": "independent",
      "hook_sha256": null
    }
  ],
  "dependencies": []
}
