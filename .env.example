# Sal runtime
ANTHROPIC_API_KEY=
SAL_MODEL=claude-sonnet-5-5
SPEND_CAP=200
DEMO_MODE=live            # live | replay
DB_BACKEND=singlestore    # singlestore | sqlite
# Senso
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
# Superlinked SIE Serverless
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_EMBED_MODEL=
SIE_RERANK_MODEL=
SIE_EXTRACT_MODEL=        # gliner2 family: entities from tech messages
SIE_LLM_MODEL=            # small instruct LLM for sub-calls (e.g. Qwen3-4B-Instruct); chat_completions
SIE_VLM_MODEL=            # vision LM for OCR of scanned bills/receipts; generate(images=...)
SIE_DOC_MODEL=            # structured doc extraction (PDF/CSV statements); extract(output_schema=...)
# SingleStore
SINGLESTORE_URL=          # user:pass@host:3306/sal
# Cognee Cloud
COGNEE_URL=               # https://<tenant>.aws.cognee.ai
COGNEE_API_KEY=
# Amplitude Agent Analytics
AMPLITUDE_AI_API_KEY=
# Statsig
STATSIG_SERVER_SECRET=
STATSIG_CONSOLE_API_KEY=
# Shopify (Dev Dashboard app, client credentials grant)
SHOPIFY_SHOP=             # yourstore.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Firedrill (CLI signs in via browser; event code TOKENSAND)
FIREDRILL_WORKSPACE=
# Persona (Know Your Agent: re-verify the owner before over-cap orders). Sandbox key.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=      # itmpl_... (Government ID + Selfie, sandbox)
# Airbyte (context layer: shop bookings + vendor price sheets)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=
# Stretch
TELEGRAM_BOT_TOKEN=
ARCEE_API_KEY=
